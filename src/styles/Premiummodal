/* ========================================================================
   PremiumModal — pm-* (sijoita src/styles/ ja lisää keskitettyyn indexiin)
======================================================================== */

.pm-overlay {
  position: fixed;
  inset: 0;
  z-index: 1200;
  background: rgba(2, 4, 10, 0.75);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  overflow-y: auto;
}

.pm-box {
  position: relative;
  width: 100%;
  max-width: 560px;
  max-height: calc(100vh - 2rem);
  overflow-y: auto;
  background: linear-gradient(180deg, rgba(10, 16, 30, 0.98), rgba(5, 8, 20, 0.99));
  border: 1px solid rgba(0, 255, 198, 0.2);
  border-radius: 20px;
  padding: 1.75rem 1.5rem 1.25rem;
  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.7), 0 0 60px rgba(0, 255, 200, 0.08);
  color: #e6e9ef;
}

.pm-close {
  position: absolute;
  top: 12px;
  right: 12px;
  background: none;
  border: none;
  color: rgba(255, 255, 255, 0.5);
  font-size: 18px;
  cursor: pointer;
  line-height: 1;
  padding: 4px;
}
.pm-close:hover { color: #fff; }

.pm-title {
  font-size: 1.45rem;
  font-weight: 800;
  margin: 0 0 0.35rem;
  color: #ffffff;
}
.pm-title-accent { color: #00ffc6; }

.pm-sub {
  font-size: 0.85rem;
  color: #94a3b8;
  margin: 0 0 1rem;
}

/* Viime yön toteuma (näkyy vain kun oikeaa dataa on) */
.pm-proof {
  background: rgba(0, 255, 198, 0.08);
  border: 1px solid rgba(0, 255, 198, 0.3);
  border-radius: 12px;
  padding: 0.75rem 1rem;
  font-size: 0.85rem;
  line-height: 1.5;
  color: #d9fff4;
  margin-bottom: 1rem;
}

/* Vertailu */
.pm-compare {
  display: grid;
  grid-template-columns: 1fr auto 1.2fr;
  gap: 0.75rem;
  align-items: start;
  margin-bottom: 1rem;
}

.pm-col {
  border-radius: 12px;
  padding: 0.75rem 0.9rem;
  min-width: 0;
}
.pm-col h4 { margin: 0 0 0.5rem; font-size: 0.85rem; }
.pm-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
.pm-col li { font-size: 0.78rem; line-height: 1.4; color: #cbd5e1; }

.pm-col--free {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
}
.pm-col--premium {
  background: rgba(0, 255, 198, 0.06);
  border: 1px solid rgba(0, 255, 198, 0.3);
}
.pm-col--premium h4 { color: #00ffc6; }

.pm-vs {
  align-self: center;
  font-size: 0.7rem;
  font-weight: 800;
  color: #64748b;
}

/* Laskentakaava */
.pm-formula {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 0.8rem 1rem;
  margin-bottom: 1.1rem;
  font-size: 0.8rem;
  line-height: 1.5;
}
.pm-formula-head { font-weight: 700; color: #e6e9ef; margin-bottom: 0.5rem; }
.pm-formula-row { color: #94a3b8; }
.pm-formula-row--premium { color: #d9fff4; }
.pm-formula-label { font-weight: 700; margin-right: 4px; }
.pm-formula-arrow { text-align: center; color: #475569; margin: 2px 0; }

/* Hintapassit */
.pm-tiers {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.6rem;
  margin-bottom: 0.9rem;
}

.pm-tier {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 0.9rem 0.5rem 0.7rem;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 14px;
  color: #e6e9ef;
  cursor: pointer;
  transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}
.pm-tier:hover {
  transform: translateY(-2px);
  border-color: rgba(0, 255, 198, 0.5);
  box-shadow: 0 0 20px rgba(0, 255, 198, 0.2);
}

.pm-tier--featured {
  background: linear-gradient(180deg, rgba(0, 255, 198, 0.14), rgba(0, 255, 198, 0.05));
  border-color: rgba(0, 255, 198, 0.55);
  box-shadow: 0 0 24px rgba(0, 255, 198, 0.18);
}

.pm-tier-badge {
  position: absolute;
  top: -9px;
  left: 50%;
  transform: translateX(-50%);
  background: #00ffc6;
  color: #04120f;
  font-size: 0.58rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  padding: 2px 8px;
  border-radius: 999px;
  white-space: nowrap;
}

.pm-tier-days { font-size: 0.78rem; font-weight: 700; color: #94a3b8; }
.pm-tier-price { font-size: 1.15rem; font-weight: 800; color: #00ffc6; }
.pm-tier-perday { font-size: 0.65rem; color: #7d8aa0; }

/* Ilmainen kokeilu — hillitty, katkoviivareunus erottaa sen selvästi
   maksuvaihtoehdoista ilman että kilpailee niiden kanssa huomiosta */
.pm-trial {
  text-align: center;
  margin-bottom: 0.9rem;
}

.pm-trial-btn {
  background: rgba(255, 255, 255, 0.03);
  border: 1px dashed rgba(0, 255, 198, 0.35);
  color: #94a3b8;
  font-size: 0.78rem;
  padding: 8px 18px;
  border-radius: 10px;
  cursor: pointer;
  transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
}
.pm-trial-btn:hover {
  border-color: rgba(0, 255, 198, 0.6);
  color: #d9fff4;
  background: rgba(0, 255, 198, 0.05);
}
.pm-trial-btn:disabled {
  opacity: 0.6;
  cursor: default;
}

.pm-trial-error {
  font-size: 0.75rem;
  color: #ff8a8a;
  margin: 0;
}

/* "Älä näytä uudelleen" -täppä, hillitysti footerin ja skipin välissä */
.pm-dismiss {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-size: 0.72rem;
  color: #64748b;
  margin-bottom: 6px;
  cursor: pointer;
  user-select: none;
}
.pm-dismiss input {
  width: 13px;
  height: 13px;
  accent-color: #00ffc6;
  cursor: pointer;
}

/* Footer + ohitus */
.pm-footer {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6px;
  font-size: 0.7rem;
  color: #64748b;
  margin-bottom: 0.75rem;
}

.pm-skip {
  display: block;
  margin: 0 auto;
  background: none;
  border: none;
  color: #64748b;
  font-size: 0.78rem;
  cursor: pointer;
  text-decoration: underline;
  padding: 4px;
}
.pm-skip:hover { color: #94a3b8; }

/* Mobiili */
@media (max-width: 560px) {
  .pm-box { padding: 1.5rem 1rem 1rem; }
  .pm-compare { grid-template-columns: 1fr; }
  .pm-vs { display: none; }
  .pm-tiers { grid-template-columns: 1fr; }
  .pm-tier { flex-direction: row; justify-content: space-between; padding: 0.8rem 1rem; }
  .pm-tier-badge { left: auto; right: 10px; transform: none; }
}