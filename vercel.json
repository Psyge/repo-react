{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "repo-react-sepia.vercel.app" }],
      "destination": "https://repotracker.fi/$1",
      "permanent": true
    },
    {
      "source": "/blog/photography",
      "destination": "/blog/northern-lights-photography-for-beginners",
      "permanent": true
    },
    {
      "source": "/blog/forecast",
      "destination": "/blog/reading-the-northern-lights-forecast-like-a-pro",
      "permanent": true
    },
    {
      "source": "/blog/best-time",
      "destination": "/blog/best-months-and-hours-for-the-northern-lights",
      "permanent": true
    },
    {
      "source": "/repobeetta",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}