{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "proxy": {
    "entrypoint": "Middleware.js",
    "matcher": "/((?!_vercel|api/|.*\\.).*)"
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "repo-react-sepia.vercel.app" }],
      "destination": "https://repotracker.fi/$1",
      "permanent": true
    }
  ]
}